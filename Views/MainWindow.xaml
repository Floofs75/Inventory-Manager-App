<Window x:Class="InventoryManager.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Inventory Manager" Height="450" Width="800">
    
    <Grid Margin="20">
        
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Action Bar -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
            <Button x:Name="AddProductButton" Content="Add Sample Product" Click="AddProductButton_Click" Width="150" Height="30" Margin="0,0,10,0"/>
            <Button x:Name="RefreshButton" Content="Refresh List" Click="RefreshButton_Click" Width="100" Height="30"/>
        </StackPanel>

        <!-- Product Data Grid (Table) -->
        <DataGrid x:Name="ProductDataGrid" Grid.Row="1" AutoGenerateColumns="True" CanUserAddRows="False" IsReadOnly="True"/>
    
    </Grid>
    
</Window>